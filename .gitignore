# Lead working files — internal creation-time briefs, not part of the public release
.briefs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Python (for any future scripts in skills/*/assets)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# LaTeX build artifacts (when downloading IEEEtran for examples)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
