# Node (for any link-check scripts)
node_modules/
package-lock.json

# Local references downloads — pdfs are downloaded by .github/workflows/check-links.yml or by maintainers,
# committed only when official + license permits redistribution. Otherwise tracked via URL only.
skills/*/references/*.pdf.tmp
